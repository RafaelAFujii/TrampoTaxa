# Configurações do Microsoft SQL Server (Docker Container)
# docker run -e "ACCEPT_EULA=Y" -e "MSSQL_SA_PASSWORD=YourStrong(!)Password123" -p 1433:1433 --name trampotaxa-sqlserver -d mcr.microsoft.com/mssql/server:2022-latest
